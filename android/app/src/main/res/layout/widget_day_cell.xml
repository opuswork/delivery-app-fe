<?xml version="1.0" encoding="utf-8"?>
<!-- Day number, up to three 납품처 chips, and "+N" for the rest. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_cell"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="1dp"
    android:paddingTop="2dp"
    android:paddingEnd="1dp">

    <TextView
        android:id="@+id/day_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingBottom="1dp"
        android:textColor="@color/widget_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/day_chip_1"
        style="@style/WidgetChip" />

    <TextView
        android:id="@+id/day_chip_2"
        style="@style/WidgetChip" />

    <TextView
        android:id="@+id/day_chip_3"
        style="@style/WidgetChip" />

    <TextView
        android:id="@+id/day_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
